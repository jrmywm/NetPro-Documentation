#!/usr/bin/env bash
set -euo pipefail

STATE_DIR=/run/netpro-google-test
STATE_FILE="$STATE_DIR/state"
HOSTS_TAG=netpro-google-test
GOOGLE_HOST=www.google.com
MIRROR_START=/usr/local/sbin/netpro-proxy-mirror-start
MIRROR_STOP=/usr/local/sbin/netpro-proxy-mirror-stop

if [[ $EUID -ne 0 ]]; then
    echo "Run with sudo: sudo $0 GOOGLE_IPV4" >&2
    exit 1
fi

if [[ $# -ne 1 || ! $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "Usage: sudo $0 GOOGLE_IPV4" >&2
    exit 1
fi

IFS=. read -r IP_A IP_B IP_C IP_D <<< "$1"
for OCTET in "$IP_A" "$IP_B" "$IP_C" "$IP_D"; do
    if (( 10#$OCTET > 255 )); then
        echo "Invalid IPv4 address: $1" >&2
        exit 1
    fi
done

if [[ -e $STATE_FILE ]]; then
    echo "NetPro Google test is already active. Run $MIRROR_STOP through the test stop helper first." >&2
    exit 1
fi

if [[ ! -x $MIRROR_START || ! -x $MIRROR_STOP ]]; then
    echo "Proxy mirror helpers are missing or not executable." >&2
    exit 1
fi

GOOGLE_IP=$1
RP_FILTER=$(sysctl -n net.ipv4.conf.all.rp_filter)
TINYP_ACTIVE=$(systemctl is-active tinyproxy 2>/dev/null || true)

mkdir -p "$STATE_DIR"
printf 'RP_FILTER=%q\nTINYP_ACTIVE=%q\n' \
    "$RP_FILTER" "$TINYP_ACTIVE" > "$STATE_FILE"
chmod 600 "$STATE_FILE"

rollback() {
    "$MIRROR_STOP" >/dev/null 2>&1 || true
    sysctl -q -w "net.ipv4.conf.all.rp_filter=$RP_FILTER" || true
    sed -i "\\|# $HOSTS_TAG$|d" /etc/hosts
    if [[ $TINYP_ACTIVE != active ]]; then
        systemctl stop tinyproxy >/dev/null 2>&1 || true
    fi
    rm -f "$STATE_FILE"
    rmdir "$STATE_DIR" 2>/dev/null || true
}
trap rollback ERR

sed -i "\\|# $HOSTS_TAG$|d" /etc/hosts
printf '%s %s # %s\n' "$GOOGLE_IP" "$GOOGLE_HOST" "$HOSTS_TAG" >> /etc/hosts

systemctl start tinyproxy
sysctl -q -w net.ipv4.conf.all.rp_filter=0
"$MIRROR_START"

trap - ERR
echo "NetPro Google test gateway ready."
echo "Pinned address: $GOOGLE_HOST -> $GOOGLE_IP"
echo "Proxy: http://192.168.80.128:8888"
